{
    "name": "nvl/forms",
    "description": "Secure dynamic Laravel forms with localized content and submission workflows",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "forms", "validation", "spam-protection", "translation"],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/data": "^1.0",
        "nvl/filterable": "^1.0",
        "nvl/support": "^1.0",
        "nvl/translatable": "^1.0",
        "ramsey/uuid": "^4.7",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "nvl/activity": "Can consume the package's after-commit events in an application-owned audit integration"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Forms\\": "src/",
            "Nvl\\Forms\\Database\\Factories\\": "database/factories/",
            "Nvl\\Forms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Forms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Forms\\Providers\\FormsServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

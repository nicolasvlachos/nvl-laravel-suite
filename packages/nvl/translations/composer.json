{
    "name": "nvl/translations",
    "description": "Translation catalog scanning, editing, import, and export for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "translations", "localization", "i18n"],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/data": "^1.0",
        "nvl/filterable": "^1.0",
        "nvl/support": "^1.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Translations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Translations\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --configuration=phpunit.xml.dist --test-directory=tests --bootstrap=tests/Pest.php --compact tests"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Translations\\Providers\\TranslationsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

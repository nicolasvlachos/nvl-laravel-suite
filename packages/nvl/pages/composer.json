{
    "name": "nvl/pages",
    "description": "Hierarchical, translatable, content-composed pages and dynamic page resources for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "pages", "cms", "content", "seo", "sitemap", "translations"],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.8",
        "nvl/content": "^1.0",
        "nvl/data": "^1.0",
        "nvl/filterable": "^1.0",
        "nvl/metafields": "^1.0",
        "nvl/seo": "^1.0",
        "nvl/translatable": "^1.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-kernel": "^7.2 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "nvl/media": "^1.0",
        "nvl/support": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Pages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": ["@format:test", "@analyse", "@test"],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Pages\\Providers\\PagesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

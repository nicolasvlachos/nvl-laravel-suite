{
    "name": "nvl/primitives",
    "description": "Immutable application value objects, exact money, validation, and ISO reference catalogs for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "value-object", "money", "phone", "iban", "locale", "currency"],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "brick/math": "^0.14 || ^0.15 || ^0.16 || ^0.17 || ^0.18",
        "brick/money": "^0.11 || ^0.14",
        "giggsey/libphonenumber-for-php": "^9.0",
        "jschaedl/iban-validation": "^2.7",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/data": "^1.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/intl": "^7.0 || ^8.0",
        "symfony/polyfill-intl-icu": "^1.33"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "ext-intl": "Enables locale-aware monetary formatting through Brick Money."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Primitives\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Primitives\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": ["@format:test", "@analyse", "@test"],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Primitives\\Providers\\PrimitivesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "name": "nvl/data",
    "description": "Standalone package for Spatie Data transformations",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "data-transfer-object", "typescript", "spatie-data"],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "laravel/framework": "^12.0 || ^13.0",
        "nvl/support": "^1.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "ext-zip": "Enables downloadable archives for the generated TypeScript declaration API."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Data\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Data\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Data\\Providers\\DataServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

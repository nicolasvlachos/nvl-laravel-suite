{
    "name": "nvl/csv",
    "description": "Typed, memory-conscious CSV analysis, validation, transformation, import, export, and queued processing for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "csv", "import", "export", "validation", "queue"],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/serializable-closure": "^2.0.10",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/data": "^1.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Csv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Csv\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Csv\\Providers\\CsvServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nvl/suite-workbench",
    "type": "project",
    "description": "Integration workbench for the NVL Laravel Suite.",
    "keywords": [
        "laravel",
        "monorepo",
        "nvl",
        "packages"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "nvl/activity": "dev-main",
        "nvl/auth": "dev-main",
        "nvl/comments": "dev-main",
        "nvl/content": "dev-main",
        "nvl/csv": "dev-main",
        "nvl/data": "dev-main",
        "nvl/filterable": "dev-main",
        "nvl/forms": "dev-main",
        "nvl/mail-notifications": "dev-main",
        "nvl/media": "dev-main",
        "nvl/metafields": "dev-main",
        "nvl/pages": "dev-main",
        "nvl/primitives": "dev-main",
        "nvl/seo": "dev-main",
        "nvl/settings": "dev-main",
        "nvl/support": "dev-main",
        "nvl/taxonomy": "dev-main",
        "nvl/templates": "dev-main",
        "nvl/translatable": "dev-main",
        "nvl/translations": "dev-main",
        "spatie/laravel-activitylog": "^4.10 || ^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Nvl\\Data\\": "packages/nvl/data/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Nvl\\Data\\Tests\\": "packages/nvl/data/tests/",
            "Nvl\\Auth\\Tests\\": "packages/nvl/auth/tests/",
            "Nvl\\Media\\Tests\\": "packages/nvl/media/tests/",
            "Nvl\\Activity\\Tests\\": "packages/nvl/activity/tests/",
            "Nvl\\Comments\\Tests\\": "packages/nvl/comments/tests/",
            "Nvl\\Content\\Tests\\": "packages/nvl/content/tests/",
            "Nvl\\Csv\\Tests\\": "packages/nvl/csv/tests/",
            "Nvl\\Forms\\Tests\\": "packages/nvl/forms/tests/",
            "Nvl\\MailNotifications\\Tests\\": "packages/nvl/mail-notifications/tests/",
            "Nvl\\Settings\\Tests\\": "packages/nvl/settings/tests/",
            "Nvl\\Translations\\Tests\\": "packages/nvl/translations/tests/",
            "Nvl\\Translatable\\Tests\\": "packages/nvl/translatable/tests/",
            "Nvl\\Filterable\\Tests\\": "packages/nvl/filterable/tests/",
            "Nvl\\Metafields\\Tests\\": "packages/nvl/metafields/tests/",
            "Nvl\\Pages\\Tests\\": "packages/nvl/pages/tests/",
            "Nvl\\Primitives\\Tests\\": "packages/nvl/primitives/tests/",
            "Nvl\\Seo\\Tests\\": "packages/nvl/seo/tests/",
            "Nvl\\Support\\Tests\\": "packages/nvl/support/tests/",
            "Nvl\\Taxonomy\\Tests\\": "packages/nvl/taxonomy/tests/",
            "Nvl\\Templates\\Tests\\": "packages/nvl/templates/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "analyse": "phpstan analyse --memory-limit=2G",
        "packages:analyse": "@php tools/analyse-packages.php",
        "dependencies:check": "@php package-dependency-audit.php",
        "contracts:check": "@php tools/check-package-contracts.php",
        "contracts:update": "@php tools/check-package-contracts.php --update",
        "packages:validate": "@php tools/validate-package-family.php",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "format": "pint --parallel --format agent app bootstrap/app.php bootstrap/providers.php config database routes tests packages/nvl tools/fixtures/activity-production-consumer tools/fixtures/comments-production-consumer",
        "format:test": "pint --parallel --test --format agent app bootstrap/app.php bootstrap/providers.php config database routes tests packages/nvl tools/fixtures/activity-production-consumer tools/fixtures/comments-production-consumer",
        "quality": [
            "@format:test",
            "@analyse",
            "@packages:analyse",
            "@dependencies:check",
            "@packages:validate",
            "@contracts:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=1G vendor/bin/pest --compact",
            "@test:packages"
        ],
        "test:integration": "@php -d memory_limit=1G vendor/bin/pest --compact tests/Feature/Integration",
        "test:packages": "for package_dir in packages/nvl/*; do vendor/bin/pest --test-directory=\"$package_dir/tests\" --configuration=\"$package_dir/phpunit.xml.dist\" --bootstrap=vendor/autoload.php --compact \"$package_dir/tests\" || exit $?; done",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "packages": {
            "type": "path",
            "url": "packages/*/*"
        }
    }
}

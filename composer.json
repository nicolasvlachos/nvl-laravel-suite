{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nvl/laravel-suite",
    "type": "library",
    "description": "A cohesive Laravel suite for authentication, content, media, pages, forms, taxonomy, translations, and application infrastructure.",
    "keywords": [
        "laravel",
        "authentication",
        "cms",
        "media",
        "packages"
    ],
    "homepage": "https://github.com/nicolasvlachos/nvl-laravel-suite",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nicolasvlachos/nvl-laravel-suite/issues",
        "source": "https://github.com/nicolasvlachos/nvl-laravel-suite",
        "docs": "https://github.com/nicolasvlachos/nvl-laravel-suite#readme",
        "security": "https://github.com/nicolasvlachos/nvl-laravel-suite/security/policy"
    },
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-tokenizer": "*",
        "ext-xmlwriter": "*",
        "aws/aws-sdk-php": "^3.322.9",
        "brick/math": "^0.14 || ^0.15 || ^0.16 || ^0.17 || ^0.18",
        "brick/money": "^0.11 || ^0.14",
        "giggsey/libphonenumber-for-php": "^9.0",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "guzzlehttp/psr7": "^2.7",
        "jschaedl/iban-validation": "^2.7",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/serializable-closure": "^2.0.10",
        "league/flysystem": "^3.25",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mpdf/mpdf": "^8.2.5",
        "nesbot/carbon": "^3.8",
        "opis/json-schema": "^2.6",
        "paragonie/constant_time_encoding": "^2.6 || ^3.0",
        "pragmarx/google2fa": "^9.0",
        "ramsey/uuid": "^4.7",
        "spatie/image": "^3.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/typescript-transformer": "^3.3",
        "symfony/finder": "^7.0 || ^8.0",
        "symfony/html-sanitizer": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.2 || ^8.0",
        "symfony/http-kernel": "^7.2 || ^8.0",
        "symfony/intl": "^7.0 || ^8.0",
        "symfony/mailer": "^7.0 || ^8.0",
        "symfony/mime": "^7.0 || ^8.0",
        "symfony/polyfill-intl-icu": "^1.33",
        "symfony/serializer": "^7.2 || ^8.0",
        "symfony/uid": "^7.2 || ^8.0",
        "web-auth/webauthn-lib": "5.3.*"
    },
    "require-dev": {
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spomky-labs/cbor-php": "^3.0",
        "web-auth/cose-lib": "^4.2.3"
    },
    "replace": {
        "nvl/activity": "self.version",
        "nvl/auth": "self.version",
        "nvl/comments": "self.version",
        "nvl/content": "self.version",
        "nvl/csv": "self.version",
        "nvl/data": "self.version",
        "nvl/filterable": "self.version",
        "nvl/forms": "self.version",
        "nvl/mail-notifications": "self.version",
        "nvl/media": "self.version",
        "nvl/metafields": "self.version",
        "nvl/pages": "self.version",
        "nvl/primitives": "self.version",
        "nvl/seo": "self.version",
        "nvl/settings": "self.version",
        "nvl/support": "self.version",
        "nvl/taxonomy": "self.version",
        "nvl/templates": "self.version",
        "nvl/translatable": "self.version",
        "nvl/translations": "self.version"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Renders server-side QR codes for TOTP provisioning when a headless URI is not sufficient.",
        "ext-gd": "Provides the default Media image-processing driver.",
        "ext-imagick": "Provides an alternative Media image-processing driver.",
        "ext-intl": "Enables locale-aware monetary formatting through Brick Money.",
        "ext-zip": "Enables downloadable archives for generated TypeScript declarations.",
        "jcupitt/vips": "Provides the optional libvips Media image-processing driver.",
        "laravel/socialite": "Enables the optional OAuth identity adapter."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Suite\\": "src/",
            "Nvl\\Activity\\": "packages/nvl/activity/src/",
            "Nvl\\Activity\\Database\\Factories\\": "packages/nvl/activity/database/factories/",
            "Nvl\\Activity\\Database\\Seeders\\": "packages/nvl/activity/database/seeders/",
            "Nvl\\Auth\\": "packages/nvl/auth/src/",
            "Nvl\\Auth\\Database\\Factories\\": "packages/nvl/auth/database/factories/",
            "Nvl\\Comments\\": "packages/nvl/comments/src/",
            "Nvl\\Content\\": "packages/nvl/content/src/",
            "Nvl\\Csv\\": "packages/nvl/csv/src/",
            "Nvl\\Data\\": "packages/nvl/data/src/",
            "Nvl\\Filterable\\": "packages/nvl/filterable/src/",
            "Nvl\\Forms\\": "packages/nvl/forms/src/",
            "Nvl\\Forms\\Database\\Factories\\": "packages/nvl/forms/database/factories/",
            "Nvl\\Forms\\Database\\Seeders\\": "packages/nvl/forms/database/seeders/",
            "Nvl\\MailNotifications\\": "packages/nvl/mail-notifications/src/",
            "Nvl\\MailNotifications\\Database\\Factories\\": "packages/nvl/mail-notifications/database/factories/",
            "Nvl\\Media\\": "packages/nvl/media/src/",
            "Nvl\\Media\\Database\\Factories\\": "packages/nvl/media/database/factories/",
            "Nvl\\Media\\Database\\Seeders\\": "packages/nvl/media/database/seeders/",
            "Nvl\\Metafields\\": "packages/nvl/metafields/src/",
            "Nvl\\Metafields\\Database\\Factories\\": "packages/nvl/metafields/database/factories/",
            "Nvl\\Pages\\": "packages/nvl/pages/src/",
            "Nvl\\Primitives\\": "packages/nvl/primitives/src/",
            "Nvl\\Seo\\": "packages/nvl/seo/src/",
            "Nvl\\Seo\\Database\\Factories\\": "packages/nvl/seo/database/factories/",
            "Nvl\\Settings\\": "packages/nvl/settings/src/",
            "Nvl\\Support\\": "packages/nvl/support/src/",
            "Nvl\\Taxonomy\\": "packages/nvl/taxonomy/src/",
            "Nvl\\Templates\\": "packages/nvl/templates/src/",
            "Nvl\\Translatable\\": "packages/nvl/translatable/src/",
            "Nvl\\Translations\\": "packages/nvl/translations/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Workbench\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\": "tests/",
            "Nvl\\Activity\\Tests\\": "packages/nvl/activity/tests/",
            "Nvl\\Auth\\Tests\\": "packages/nvl/auth/tests/",
            "Nvl\\Comments\\Tests\\": "packages/nvl/comments/tests/",
            "Nvl\\Content\\Tests\\": "packages/nvl/content/tests/",
            "Nvl\\Csv\\Tests\\": "packages/nvl/csv/tests/",
            "Nvl\\Data\\Tests\\": "packages/nvl/data/tests/",
            "Nvl\\Filterable\\Tests\\": "packages/nvl/filterable/tests/",
            "Nvl\\Forms\\Tests\\": "packages/nvl/forms/tests/",
            "Nvl\\MailNotifications\\Tests\\": "packages/nvl/mail-notifications/tests/",
            "Nvl\\Media\\Tests\\": "packages/nvl/media/tests/",
            "Nvl\\Metafields\\Tests\\": "packages/nvl/metafields/tests/",
            "Nvl\\Pages\\Tests\\": "packages/nvl/pages/tests/",
            "Nvl\\Primitives\\Tests\\": "packages/nvl/primitives/tests/",
            "Nvl\\Seo\\Tests\\": "packages/nvl/seo/tests/",
            "Nvl\\Settings\\Tests\\": "packages/nvl/settings/tests/",
            "Nvl\\Support\\Tests\\": "packages/nvl/support/tests/",
            "Nvl\\Taxonomy\\Tests\\": "packages/nvl/taxonomy/tests/",
            "Nvl\\Templates\\Tests\\": "packages/nvl/templates/tests/",
            "Nvl\\Translatable\\Tests\\": "packages/nvl/translatable/tests/",
            "Nvl\\Translations\\Tests\\": "packages/nvl/translations/tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/consumer-audit/",
            "tests/Fixtures/consumer-audit-reviewer-probe/"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=2G",
            "phpstan analyse --memory-limit=2G tools/fixtures/auth-production-consumer/app",
            "phpstan analyse --memory-limit=2G tools/fixtures/content-production-consumer/app"
        ],
        "autoload:check": "@composer dump-autoload --optimize --strict-psr --strict-ambiguous --no-scripts --no-interaction",
        "package:quality": "@php tools/run-package-quality.php",
        "packages:analyse": "@php tools/analyse-packages.php",
        "dependencies:check": "@php package-dependency-audit.php",
        "contracts:check": "@php tools/check-package-contracts.php",
        "contracts:update": "@php tools/check-package-contracts.php --update",
        "types:check": [
            "@php artisan nvl:data:types:check --fail-on-warning",
            "npm run types:check"
        ],
        "skills:sync": "@php tools/sync-suite-skills.php",
        "packages:validate": "@php tools/validate-package-family.php",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "format": "pint --parallel --format agent app bootstrap/app.php bootstrap/providers.php config database routes src tests packages/nvl tools/check-release-changelogs.php tools/fixtures/activity-production-consumer tools/fixtures/auth-production-consumer tools/fixtures/comments-production-consumer tools/fixtures/content-production-consumer tools/fixtures/suite-release-consumer",
        "format:test": "pint --parallel --test --format agent app bootstrap/app.php bootstrap/providers.php config database routes src tests packages/nvl tools/check-release-changelogs.php tools/fixtures/activity-production-consumer tools/fixtures/auth-production-consumer tools/fixtures/comments-production-consumer tools/fixtures/content-production-consumer tools/fixtures/suite-release-consumer",
        "quality": [
            "@format:test",
            "@autoload:check",
            "@analyse",
            "@packages:analyse",
            "@dependencies:check",
            "@packages:validate",
            "@contracts:check",
            "@types:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=1G vendor/bin/pest --compact",
            "@test:packages"
        ],
        "test:integration": "@php -d memory_limit=1G vendor/bin/pest --compact tests/Feature/Integration",
        "test:media-production": "NVL_MEDIA_PRODUCTION_INTEGRATION=true vendor/bin/pest --test-directory=packages/nvl/media/tests --configuration=packages/nvl/media/phpunit.xml.dist --bootstrap=vendor/autoload.php --compact packages/nvl/media/tests/Integration/ProductionStackTest.php",
        "test:packages": "for package_dir in packages/nvl/*; do vendor/bin/pest --test-directory=\"$package_dir/tests\" --configuration=\"$package_dir/phpunit.xml.dist\" --bootstrap=vendor/autoload.php --compact \"$package_dir/tests\" || exit $?; done",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Suite\\SuiteServiceProvider"
            ]
        }
    },
    "archive": {
        "name": "nvl-laravel-suite",
        "exclude": [
            "/.agents",
            "/.claude",
            "/.codex",
            "/.github",
            "/.idea",
            "/.temp",
            "/.DS_Store",
            "/.editorconfig",
            "/.git",
            "/.gitattributes",
            "/.gitignore",
            "/.mcp.json",
            "/.npmrc",
            "/.phpunit.cache",
            "/.superpowers",
            "/.worktrees",
            "/AGENTS.md",
            "/CLAUDE.md",
            "/app",
            "/artisan",
            "/bootstrap",
            "/boost.json",
            "/build",
            "/composer-dependency-analyser.php",
            "/coverage",
            "/database",
            "/node_modules",
            "/package-dependency-audit.php",
            "/pint.json",
            "/public",
            "/references",
            "/rename_dtos.php",
            "/resources/css",
            "/resources/js",
            "/resources/views",
            "/resources/.DS_Store",
            "/routes",
            "/storage",
            "/test.log",
            "/tests",
            "/tools",
            "/tsconfig.json",
            "/vendor",
            "/vite.config.js",
            "/.env*",
            "/composer.lock",
            "/package-lock.json",
            "/package.json",
            "/phpstan.neon.dist",
            "/phpunit.xml",
            "/packages/**/.temp",
            "/packages/.DS_Store",
            "/packages/nvl/.DS_Store",
            "/packages/nvl/*/.DS_Store",
            "/packages/nvl/*/.gitattributes",
            "/packages/nvl/*/.gitignore",
            "/packages/nvl/*/.phpunit.cache",
            "/packages/nvl/*/**/.gitkeep",
            "/packages/**/tests",
            "/packages/**/composer.json",
            "/packages/**/composer.lock",
            "/packages/**/composer-dependency-analyser.php",
            "/packages/**/composer-require-checker.json",
            "/packages/**/phpstan.neon.dist",
            "/packages/**/phpunit*.xml*",
            "/packages/**/tmp"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
